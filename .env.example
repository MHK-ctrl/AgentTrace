# ─────────────────────────────────────────────────────────────
# AgentTrace environment configuration (placeholders only)
# Copy to .env or run `npm run setup` to generate a local .env.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string used by the API and migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenttrace

# Isolated database used by automated API tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenttrace_test

# API server
AGENTTRACE_API_PORT=4000
AGENTTRACE_API_HOST=127.0.0.1
AGENTTRACE_API_URL=http://127.0.0.1:4000
AGENTTRACE_API_BASE_URL=http://127.0.0.1:4000
AGENTTRACE_API_URL_WS=ws://127.0.0.1:4000
# Optional: explicit WebSocket base URL (defaults to AGENTTRACE_API_URL with ws://)
# AGENTTRACE_WS_URL=ws://127.0.0.1:4000
# Comma-separated list of allowed browser origins for the API.
AGENTTRACE_CORS_ORIGINS=http://localhost:3000

# Secret shared by the dashboard server and the API. It is never exposed to
# the browser: dashboard requests are proxied server-side.
# Generate with: openssl rand -hex 32
AGENTTRACE_DASHBOARD_TOKEN=replace-with-a-long-random-token

# Session signing secret used by the admin auth cookie. Never commit this value.
AGENTTRACE_SESSION_SECRET=replace-with-a-long-random-hex-secret

# Demo project + ingestion key used by the example agent.
AGENTTRACE_DEMO_PROJECT_ID=00000000-0000-4000-8000-000000000001
AGENTTRACE_DEMO_API_KEY=at_live_replace_me

# Optional: the example agent's endpoint (defaults to AGENTTRACE_API_URL)
# AGENTTRACE_ENDPOINT=http://localhost:4000

# Set to 1 to include demo seed data (default on for local development).
AGENTTRACE_SEED_DEMO=1

# Public demo configuration
AGENTTRACE_PUBLIC_DEMO=1

# Demo session configuration
AGENTTRACE_DEMO_SESSION_TTL_HOURS=24
AGENTTRACE_DEMO_MAX_RUNS=8
AGENTTRACE_DEMO_COOLDOWN_SECONDS=30
AGENTTRACE_DEMO_MAX_CONCURRENT_RUNS=1

# Production URLs (set when deploying)
# AGENTTRACE_DASHBOARD_URL=https://your-domain.com
# AGENTTRACE_API_URL=https://api.your-domain.com
# AGENTTRACE_API_BASE_URL=https://api.your-domain.com
# AGENTTRACE_API_URL_WS=wss://api.your-domain.com