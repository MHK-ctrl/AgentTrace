[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# AgentTrace environment configuration
# Copy to .env for local development or set on your hosting provider.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
# Local development: postgresql://postgres:postgres@localhost:5432/agenttrace
# Production (Neon free tier): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Set this on your hosting provider (Render/Netlify) - do not commit to git

# ── API Server ──────────────────────────────────────────────────
AGENTTRACE_API_PORT=4000
AGENTTRACE_API_HOST=127.0.0.1
AGENTTRACE_API_URL=http://127.0.0.1:4000
AGENTTRACE_API_BASE_URL=http://127.0.0.1:4000
AGENTTRACE_API_URL_WS=ws://127.0.0.1:4000
# Explicit WebSocket base URL (defaults to AGENTTRACE_API_URL with ws://)
# AGENTTRACE_WS_URL=ws://127.0.0.1:4000
# Comma-separated list of allowed browser origins for the API.
AGENTTRACE_CORS_ORIGINS=http://localhost:3000

# ── Auth & Session ─────────────────────────────────────────────
# Secret shared by the dashboard server and the API. Never exposed to browser.
# Generate with: openssl rand -hex 32
# Must be a 32-character hex string for the HTTP-only admin cookie.
AGENTTRACE_DASHBOARD_TOKEN=REPLACE_WITH_A_FRESH_32_BYTE_HEX_TOKEN
AGENTTRACE_SESSION_SECRET=replace-with-a-long-random-hex-secret

# ── Demo Configuration ──────────────────────────────────────────
# These control public demo session behavior (all free-tier compatible)
AGENTTRACE_DEMO_PROJECT_ID=00000000-0000-4000-8000-000000000001
AGENTTRACE_DEMO_API_KEY=at_live_replace_me

# Set to 1 to include demo seed data (default on for local development).
AGENTTRACE_SEED_DEMO=1

# Public demo configuration - enabled when deploying to free-tier hosting
AGENTTRACE_PUBLIC_DEMO=1

# Demo session configuration (hours, runs, cooldown, concurrency)
AGENTTRACE_DEMO_SESSION_TTL_HOURS=24
AGENTTRACE_DEMO_MAX_RUNS=8
AGENTTRACE_DEMO_COOLDOWN_SECONDS=3
AGENTTRACE_DEMO_MAX_CONCURRENT_RUNS=3

# ── Production URLs (set when deploying to free-tier hosting) ────
# Render API service URL (set after Render deploy)
# AGENTTRACE_API_URL=https://agenttrace-api.onrender.com
# AGENTTRACE_API_BASE_URL=https://agenttrace-api.onrender.com
# AGENTTRACE_API_URL_WS=wss://agenttrace-api.onrender.com

# Netlify dashboard URL (set after Netlify deploy)
# AGENTTRACE_DASHBOARD_URL=https://cerulean-travesseiro-4c6d32.netlify.app

# ── Optional: Example Agent ─────────────────────────────────────
# The example agent's override endpoint (defaults to AGENTTRACE_API_URL)
# AGENTTRACE_ENDPOINT=http://localhost:4000